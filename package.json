{
  "name": "yahaha-ai-game-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:builds": "tsx --test tests/game-builds.test.ts",
    "test:builds:integration": "node tests/run-game-build-routes.cjs",
    "test:builds:ops": "tsx --test tests/game-build-ops.test.ts",
    "test:rooms": "node --require ./tests/deny-env-reads.cjs --import tsx --test tests/game-rooms.test.ts",
    "test:rooms:platform": "node tests/run-game-rooms-platform.cjs",
    "ops:builds:report": "node --require ./tests/deny-env-reads.cjs --import tsx scripts/reconcile-builds.ts",
    "ops:check-deployment": "node --require ./tests/deny-env-reads.cjs --import tsx scripts/check-deployment.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx workers/generator/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@langchain/langgraph": "^1.4.4",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "latest",
    "bullmq": "^5.79.2",
    "ioredis": "^5.11.1",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.16.0",
    "undici": "^8.5.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
